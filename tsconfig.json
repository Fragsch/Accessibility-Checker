{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "jsx": "react-jsx",

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Die Oberflaeche wird von tsconfig.web.json erfasst: sie laeuft im Browser,
  // wird von Vite gebuendelt und braucht daher eine andere Modulaufloesung.
  "include": ["src/**/*", "werkzeuge/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "web"]
}
