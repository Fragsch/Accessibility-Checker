{
  "name": "accessibility-checker",
  "version": "0.1.0",
  "description": "Lokales Prüfwerkzeug für digitale Barrierefreiheit nach WCAG 2.1 und 2.2, Level AA",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "einrichten": "npm install && npx playwright install chromium",
    "dev": "node --run dev:server & node --run dev:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && node werkzeuge/beiwerk-kopieren.mjs && vite build",
    "start": "node dist/src/server/index.js",
    "typen:pruefen": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "scan": "tsx werkzeuge/scan.ts",
    "test": "node --run katalog:pruefen && node --run axe:abgleich && node --run typen:pruefen && node --import tsx --test \"test/*.test.ts\"",
    "katalog:pruefen": "node werkzeuge/katalog-pruefen.mjs",
    "axe:abgleich": "node werkzeuge/axe-abgleich.mjs",
    "pruefe:selbst": "tsx werkzeuge/selbstpruefung.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fastify/static": "^10.1.3",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
