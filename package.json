{
  "name": "accessibility-checker",
  "version": "0.1.0",
  "description": "Lokales Prüfwerkzeug für digitale Barrierefreiheit nach WCAG 2.1 und 2.2, Level AA",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "einrichten": "npm install && npx playwright install chromium",
    "dev": "node --run dev:server & node --run dev:web",
    "dev:server": "node --run build:node && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/src/server/index.js)",
    "dev:web": "vite",
    "build": "node --run build:node && vite build",
    "build:node": "tsc -p tsconfig.json && node werkzeuge/beiwerk-kopieren.mjs",
    "start": "node dist/src/server/index.js",
    "typen:pruefen": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "prescan": "node --run build:node",
    "scan": "node dist/werkzeuge/scan.js",
    "pretest": "node --run build:node",
    "test": "node --run katalog:pruefen && node --run axe:abgleich && node --run typen:pruefen && node --test \"dist/test/*.test.js\"",
    "katalog:pruefen": "node werkzeuge/katalog-pruefen.mjs",
    "axe:abgleich": "node werkzeuge/axe-abgleich.mjs",
    "prepruefe:selbst": "node --run build",
    "pruefe:selbst": "node dist/werkzeuge/selbstpruefung.js",
    "preverifikation": "node --run build:node",
    "verifikation": "node dist/werkzeuge/verifikation.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fastify/static": "^10.1.3",
    "@tesseract.js-data/deu": "^1.0.0",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "franc-min": "^6.2.0",
    "html-validate": "^11.8.0",
    "ollama": "^0.6.3",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
